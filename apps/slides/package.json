{
  "name": "yaokongppt",
  "productName": "遥控PPT",
  "version": "0.6.1",
  "license": "Apache-2.0",
  "homepage": "https://github.com/pptx-presenter/yaokongppt",
  "private": true,
  "description": "轻量 pptx 编辑与播放器",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "npm run rebuild-native && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild-native": "npm rebuild koffi --runtime=electron --target=43.3.0 --dist-url=https://npmmirror.com/mirrors/electron/",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "npm run rebuild-native && electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:dir": "npm run rebuild-native && electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@genoffice/i18n": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/project-store": "*",
    "@genoffice/ui": "*",
    "@types/opentype.js": "^1.3.8",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "konva": "^9.3.20",
    "opentype.js": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.0.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "author": {
    "name": "pptx演示器",
    "email": "pptx-presenter@example.com"
  },
  "build": {
    "appId": "com.pptxpresenter.slides",
    "productName": "遥控PPT",
    "executableName": "遥控PPT",
    "electronVersion": "43.3.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "fileAssociations": [
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      "resources/icon.ico",
      "resources/icon.png",
      { "from": "resources/remote-control", "to": "remote-control" }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-green-portable.${ext}"
    },
    "zip": {
      "artifactName": "${productName}-${version}-win-${arch}-green-win-unpacked.${ext}"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Office",
      "icon": "resources/icon.png",
      "maintainer": "pptx演示器 <pptx-presenter@example.com>"
    },
    "deb": {
      "afterInstall": "build/after-install.sh"
    },
    "toolsets": {
      "appimage": "1.0.2"
    },
    "icon": "resources/icon.ico"
  },
  "dependencies": {
    "@genoffice/electron-utils": "*",
    "acorn": "^8.18.0",
    "harfbuzzjs": "^1.4.0",
    "koffi": "^3.2.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "utif2": "^4.1.0",
    "ws": "^8.18.0"
  }
}
